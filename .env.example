APP_NAME=Meghkanya API
APP_ENV=local
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120
DATABASE_URL=sqlite:///./saree_retail.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_FULL_NAME=System Admin

# Production PostgreSQL example (AWS RDS)
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg2://username:password@your-rds-endpoint:5432/saree_retail
# CORS_ORIGINS=https://www.yourdomain.com,https://main.xxxxx.amplifyapp.com
# BOOTSTRAP_ADMIN_ENABLED=false
